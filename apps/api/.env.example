APP_NAME=IqraDB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database ---
# SQLite is the default for local dev. For production, switch DB_CONNECTION
# to mysql/pgsql and populate the matching credentials below.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USERNAME=
# DB_PASSWORD=

# --- Session / Cache / Queue ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=sync

# --- Mail (log driver is safe for local dev) ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Sanctum ---
# Token lifetime used by AuthController (hours). 0 = no expiration.
SANCTUM_TOKEN_EXPIRATION_HOURS=8

# --- Rate limiting ---
# Max requests per minute for public auth endpoints (login, register,
# forgot/reset password). Keyed by authenticated user or IP.
AUTH_THROTTLE_PER_MINUTE=10

# --- Email verification ---
# How long the signed verification link stays valid (minutes).
VERIFICATION_LINK_TTL_MINUTES=60
# Domains that receive stateful auth cookies. Only needed when the web app
# uses SPA-cookie auth instead of the default bearer-token auth.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000

# --- CORS ---
# Comma-separated list of origins that may call the API from a browser.
# The web app origin(s) must be listed here.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGIN_PATTERNS=
CORS_MAX_AGE=0
# Only set to true when using SPA-cookie auth mode.
CORS_SUPPORTS_CREDENTIALS=false

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- SCDB scraper ---
# The Smart Completions installation the Scrapper page automates. Browser
# automation runs on the VPS only — never on Vercel, never in the browser.
SCDB_BASE_URL=https://chiyodanfe.ceccms.com
# Comma-separated hosts Playwright may navigate to. This is the SSRF boundary:
# a recipe whose URL is not on this list cannot be saved or run. Exact host
# matches only — subdomains are NOT implied.
SCDB_ALLOWED_HOSTS=chiyodanfe.ceccms.com
# Page used to check whether a stored session still authenticates, relative to
# SCDB_BASE_URL.
SCDB_SESSION_CHECK_PATH=/

# Node binary and the apps/scraper workspace the Laravel jobs invoke.
# SCRAPER_APP_PATH defaults to ../scraper relative to apps/api.
SCRAPER_NODE_BINARY=node
# SCRAPER_APP_PATH=/var/www/iqradb/apps/scraper

# Where Chromium is installed. Leave unset to use Playwright's default per-user
# cache (~/.cache/ms-playwright) — which only works when the user that installed
# the browser is the same one running php-fpm AND the queue worker.
#
# Set this to a shared, world-readable path when those users differ, then
# install with:
#   sudo PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
#     node node_modules/playwright-core/cli.js install --with-deps chromium
# PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
# Pin one executable instead, if you manage Chromium yourself.
# PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=

# Private disk + prefix for run artifacts (downloaded CSV, failure screenshot,
# trace). Never a public directory. Authentication state is NOT stored here —
# it lives encrypted in the database.
SCRAPER_STORAGE_DISK=local
SCRAPER_STORAGE_PATH=scraper
# Delete run artifacts older than this many days (scraper:prune command).
SCRAPER_ARTIFACT_RETENTION_DAYS=14

# Timeouts. SCRAPER_TIMEOUT_SECONDS caps a whole run; the other two cap a
# single navigation or action inside it.
SCRAPER_TIMEOUT_SECONDS=300
SCRAPER_NAVIGATION_TIMEOUT_MS=30000
SCRAPER_ACTION_TIMEOUT_MS=15000
# Refuse a download larger than this many bytes (64 MB default).
SCRAPER_MAX_DOWNLOAD_BYTES=67108864

# Queue that browser runs are dispatched to. Needs its own worker on the VPS —
# see the deployment section of the README. QUEUE_CONNECTION must not be `sync`
# in production or the API request would block for the whole browser run.
SCRAPER_QUEUE=scraper
# How long a single user's scraper lock is held, in seconds. Prevents two
# Chromium contexts driving one SCDB session at the same time.
SCRAPER_LOCK_SECONDS=600
